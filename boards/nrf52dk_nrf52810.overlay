/*
 * tyresensor_overlay.dts
 * Save this file as:  C:\ncs\projects\tyre_sensor\boards\nrf52dk_nrf52810.overlay
 *
 * Purpose: remap the nRF52810 I2C bus onto the pins exposed on the
 * IndieSemiC EVK-ISC-nRF52810-A header:
 *
 *      SDA = P0.10        SCL = P0.12
 *
 * The nordic,nrf-twi node on nRF52810 is labelled i2c0 in Zephyr.
 * pinctrl groups are named default / sleep in current Zephyr.
 */

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 10)>,
				<NRF_PSEL(TWIM_SCL, 0, 12)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 10)>,
				<NRF_PSEL(TWIM_SCL, 0, 12)>;
			low-power-enable;
		};
	};
};
